<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure-logic tests: no daemon, no store, no window, no process. They exist so that the
       parts of Dodona that ARE just functions can be checked in under a second, instead of
       riding along inside a suite that has to start a daemon to reach them.

       WHY THIS IS NOT AN ACCEPTANCE SUITE. The eleven .ps1 suites verify BEHAVIOUR through
       the real binaries — that is their whole value and it is why they cost seconds rather
       than milliseconds. What they were also doing, incidentally, was covering algebra with
       no I/O in it: Claims is 53 lines of string comparison, and the only way to exercise it
       was to create a ticket, which needs a workspace, which needs a daemon. This project
       takes that half. The suites keep the other half, undiminished.

       Version-pinned to what is already in the machine's package cache, on purpose: adding a
       verification step that needs the network is adding a way for verification to be
       unavailable exactly when it is wanted. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Dodona.Tests</AssemblyName>
    <RootNamespace>Dodona.Tests</RootNamespace>
    <!-- The classes under test are `static class` with no accessibility modifier, i.e.
         internal. Dodona.csproj grants this assembly access rather than the types being
         widened to public for the sake of a test — the design's own choice about what is
         API stays the design's choice. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dodona\Dodona.csproj" />
  </ItemGroup>

</Project>
