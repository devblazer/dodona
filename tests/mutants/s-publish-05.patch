# The controls. alpha is still a target and the refusal still refuses, so the red is about the
# narrowing and not about the branch as a whole.
#
# expects-green: unit:Dodona.Tests.PublishPlanTests.named_target_is_selected
# expects-green: unit:Dodona.Tests.PublishPlanTests.unknown_target_is_refused
