<Window x:Class="DodonaUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodona" Width="1600" Height="900"
        WindowStyle="None" ResizeMode="NoResize" UseLayoutRounding="True"
        Background="#FF17191D" FontFamily="Segoe UI" Foreground="#FFD8DCE0"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_Drag">
    <!-- WindowStyle=None: the content IS the window, so screenshots are exactly
         1600x900 on every machine — the capture loop must be deterministic (§17). -->
    <Grid x:Name="Root" Background="#FF17191D">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ══ the lane grid: even 3x2, fixed positions, never reflows (§8) ══ -->
            <ItemsControl x:Name="PaneGrid" Grid.Column="0" ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" CornerRadius="6" Background="#FF1F2227"
                                BorderBrush="{Binding BorderBrushValue}" BorderThickness="{Binding BorderThicknessValue}"
                                MouseLeftButtonDown="Pane_Click" MouseRightButtonDown="Pane_Overlay">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- header: colour chip · title · blocked glyph · badge · presence -->
                                <DockPanel Grid.Row="0" Visibility="{Binding BodyVisibility}" Margin="0,0,0,6">
                                    <Rectangle DockPanel.Dock="Left" Width="10" Height="10" RadiusX="2" RadiusY="2"
                                               Fill="{Binding LaneBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Left" FontWeight="Bold" FontSize="14"
                                               Opacity="{Binding TitleOpacity}" VerticalAlignment="Center">
                                        <Run Text="{Binding FocusMark, Mode=OneWay}"/><Run Text="{Binding Title, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock DockPanel.Dock="Left" Text=" ⚠" FontSize="14" Foreground="White"
                                               Visibility="{Binding GlyphVisibility}" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Left" Background="#FFCB4B4B" CornerRadius="8" Padding="6,1"
                                            Margin="8,0,0,0" Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="11" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Presence, Mode=OneWay}" FontSize="11"
                                               Foreground="#FF8A9099" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- body: replay of the last N pane_events rows -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Lines}" Visibility="{Binding BodyVisibility}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneWay}" FontSize="12" FontFamily="Consolas"
                                                       Foreground="#FFB9BFC7" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- an empty slot stays a slot -->
                                <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="— empty slot —" FontSize="12"
                                           Foreground="#FF4A4F57" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding EmptyVisibility}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ══ dispatcher column: fixed on the right, feed + tray + input (§8) ══ -->
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- which project this grid is showing; click (or Ctrl+P) to open another -->
                <DockPanel Grid.Row="0" Margin="4,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="DISPATCHER" FontWeight="Bold" FontSize="14" Foreground="#FF9AA3AE"/>
                    <Button DockPanel.Dock="Right" Click="Project_Click" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand"
                            ToolTip="{Binding ProjectPath}">
                        <TextBlock FontSize="11" Foreground="#FF6FA8DC">
                            <Run Text="{Binding ProjectName, Mode=OneWay}"/><Run Text=" ▾"/>
                        </TextBlock>
                    </Button>
                </DockPanel>

                <Border Grid.Row="1" Background="#FF1F2227" CornerRadius="6" BorderBrush="#FF3A3E44" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Feed}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="6,4" Background="#FF262A30" CornerRadius="4" Opacity="{Binding RowOpacity}">
                                        <DockPanel>
                                            <Rectangle DockPanel.Dock="Left" Width="8" Height="8" RadiusX="2" RadiusY="2"
                                                       Fill="{Binding ChipBrush}" Margin="0,4,6,0" VerticalAlignment="Top"/>
                                            <Button DockPanel.Dock="Right" Content="ack" FontSize="10" Padding="6,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Top" Visibility="{Binding AckVisibility}"
                                                    Click="Feed_Ack" Background="#FF31363D" Foreground="#FFD8DCE0" BorderThickness="0"/>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#FFC6CCD4">
                                                <Run FontWeight="Bold" Text="{Binding LaneTitle, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Body, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="2" Text="{Binding TrayText}" FontSize="11" Foreground="#FF8A9099" Margin="4,6,0,0"/>
                <!-- wraps: a status line that matters is usually the one too long to fit -->
                <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="11" Foreground="#FF6FA8DC" Margin="4,4,0,4"
                           TextWrapping="Wrap" MaxHeight="60"/>
                <!-- What you say to the dispatcher is a paragraph, not a command line: the box
                     holds several lines, grows with what you type, and the grip drags its floor
                     taller. The pixels come out of the feed — the only star row in this column —
                     so the lane grid never reflows (§8). -->
                <DockPanel Grid.Row="4">
                    <Border DockPanel.Dock="Top" Height="7" Background="Transparent" Cursor="SizeNS"
                            ToolTip="Drag to resize — double-click to reset"
                            MouseLeftButtonDown="Grip_Down" MouseMove="Grip_Move" MouseLeftButtonUp="Grip_Up">
                        <Rectangle Width="30" Height="2" RadiusX="1" RadiusY="1" Fill="#FF4A4F57"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Grid>
                        <TextBox x:Name="InputBox" FontSize="13" Padding="6,4" Background="#FF262A30"
                                 Foreground="#FFD8DCE0" BorderBrush="#FF3A3E44" CaretBrush="#FFD8DCE0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="196"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 KeyDown="Input_KeyDown" TextChanged="Input_TextChanged"/>
                        <TextBlock x:Name="InputHint" IsHitTestVisible="False" Margin="8,7,8,0" FontSize="12"
                                   Foreground="#FF5A6069" VerticalAlignment="Top" TextWrapping="Wrap"
                                   Text="Say what you want done — Enter sends, Shift+Enter is a new line"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ══ overlay-maximize: raw transcripts need somewhere to render; Esc restores;
             the grid never reflows underneath (§8) ══ -->
        <Border Visibility="{Binding OverlayVisible}" Background="#E6121417">
            <Border Margin="60" Background="#FF1F2227" CornerRadius="8"
                    BorderBrush="{Binding OverlayPane.LaneBrush, FallbackValue=Gray}" BorderThickness="2">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock FontWeight="Bold" FontSize="20" Text="{Binding OverlayPane.Title, FallbackValue=''}"/>
                        <TextBlock DockPanel.Dock="Right" Text="Esc to restore" FontSize="11" Foreground="#FF8A9099"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OverlayPane.Lines, FallbackValue={x:Null}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}" FontSize="13" FontFamily="Consolas"
                                               Foreground="#FFC6CCD4" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
