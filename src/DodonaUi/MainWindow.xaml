<Window x:Class="DodonaUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodona" Width="1600" Height="900"
        WindowStyle="None" ResizeMode="NoResize" UseLayoutRounding="True"
        Background="#FF17191D" FontFamily="Segoe UI" Foreground="#FFD8DCE0"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_Drag">
    <!-- WindowStyle=None: the content IS the window, so screenshots are exactly
         1600x900 on every machine — the capture loop must be deterministic (§17). -->
    <Window.Resources>
        <!-- The stock scrollbar is a light-grey slab with arrow buttons: on a dark pane it
             reads as chrome competing with the text. This one is an 8px rail that only
             shows when there is somewhere to go. Every scroller here is vertical-only. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" CornerRadius="3" Margin="2,0"
                                                        Background="#FF444B55"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#FF6B7482"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <!-- click-the-rail still pages; it just has no chrome -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One transcript row, shared by the pane and the overlay. Wraps (a truncated
             line is an unreadable line), and carries the speaker as colour: a left rule
             and a bold prefix in the speaker's ink, the body in a matching tone. FontSize
             is inherited from the host so the overlay can render the same rows larger. -->
        <DataTemplate x:Key="TranscriptLine">
            <Border Margin="0,1" Padding="7,3,6,4" CornerRadius="3"
                    Background="{Binding RowBrush}"
                    BorderBrush="{Binding AccentBrush}" BorderThickness="2,0,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{Binding BodyBrush}"
                           FontFamily="{Binding FaceValue}"
                           LineHeight="16" LineStackingStrategy="BlockLineHeight"><Run
                        Text="{Binding Prefix, Mode=OneWay}" FontWeight="Bold"
                        Foreground="{Binding AccentBrush}"/><Run Text="{Binding Body, Mode=OneWay}"/></TextBlock>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="#FF17191D">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ══ the focused workspace's grid, with a band strip beneath it (§6) ══
                 Shape B: the focused workspace gets the whole 3x2 grid; every OTHER awake
                 workspace is a compact band of lane chips. Both lives visible at once
                 without halving every pane — which is what a merged grid and tabs-only each
                 got wrong in opposite directions (§8). -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- Columns bound, Rows left to UniformGrid: it divides the space itself as lanes
                 arrive. No scrolling anywhere (operator, 2026-08-18: "i dont want scroll. if
                 needed user will just collapse more") — panes shrink, and crowding is the cue
                 to collapse, not a reason for the system to start hiding work. -->
            <ItemsControl x:Name="PaneGrid" Grid.Row="0" ItemsSource="{Binding Slots}"
                          Visibility="{Binding GridVisibility}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.GridColumns,
                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" CornerRadius="6" Background="#FF1F2227"
                                BorderBrush="{Binding BorderBrushValue}" BorderThickness="{Binding BorderThicknessValue}"
                                MouseLeftButtonDown="Pane_Click" MouseRightButtonDown="Pane_Overlay">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- header: colour chip · title · blocked glyph · badge · presence -->
                                <DockPanel Grid.Row="0" Visibility="{Binding BodyVisibility}" Margin="0,0,0,6">
                                    <Rectangle DockPanel.Dock="Left" Width="10" Height="10" RadiusX="2" RadiusY="2"
                                               Fill="{Binding LaneBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Left" FontWeight="Bold" FontSize="14"
                                               Opacity="{Binding TitleOpacity}" VerticalAlignment="Center">
                                        <Run Text="{Binding FocusMark, Mode=OneWay}"/><Run Text="{Binding Title, Mode=OneWay}"/>
                                    </TextBlock>
                                    <!-- WHICH PROJECT this lane is in: one folder, a `members`
                                         row. A one-project workspace never shows it (there is
                                         one possible answer), and `no project` is the shout for
                                         a lane whose folder no project owns any
                                         more, because a detached project leaves lane rows behind
                                         (docs/LOCATIONS-PLAN.md P1.2 and Phase 2's T4). -->
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProjectLabel, Mode=OneWay}" FontSize="10"
                                               Foreground="#FF8A9099" Margin="6,2,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding ProjectVisibility}"/>
                                    <!-- which repository this lane's ticket lands in; a single-repo
                                         project never shows this at all -->
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Repo, Mode=OneWay}" FontSize="10"
                                               Foreground="#FF6B7079" Margin="6,2,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding RepoVisibility}"/>
                                    <TextBlock DockPanel.Dock="Left" Text=" ⚠" FontSize="14" Foreground="White"
                                               Visibility="{Binding GlyphVisibility}" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Left" Background="#FFCB4B4B" CornerRadius="8" Padding="6,1"
                                            Margin="8,0,0,0" Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="11" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <!-- the lane's controls: buttons, because a feed row that says
                                         "undo: dodona lane-stop 3" at a GUI user was this project's
                                         original sin. ✕ retires the agent (the thread survives, and
                                         wake resumes the session — agents are fungible, §11). -->
                                    <Button DockPanel.Dock="Right" Content="✕" FontSize="11" Padding="5,0" Margin="6,0,0,0"
                                            AutomationProperties.Name="close-lane" ToolTip="Retire this lane's agent (wake resumes it)"
                                            Visibility="{Binding CloseVisibility}" Click="Pane_Close"
                                            Background="Transparent" Foreground="#FF6B7079" BorderThickness="0" Cursor="Hand"/>
                                    <!-- Collapse to a chip. Nothing stops, nothing is demoted;
                                         it is how you make room without giving anything up. -->
                                    <Button DockPanel.Dock="Right" Content="{Binding CollapseGlyph}" FontSize="11"
                                            Padding="5,0" Margin="6,0,0,0"
                                            AutomationProperties.Name="collapse-lane"
                                            ToolTip="{Binding CollapseTip}"
                                            Visibility="{Binding CloseVisibility}" Click="Pane_Collapse"
                                            Background="Transparent" Foreground="#FF6B7079" BorderThickness="0" Cursor="Hand"/>
                                    <Button DockPanel.Dock="Right" Content="wake" FontSize="10" Padding="6,1" Margin="6,0,0,0"
                                            AutomationProperties.Name="wake-lane" ToolTip="Respawn the agent, resuming its session"
                                            Visibility="{Binding WakeVisibility}" Click="Pane_Wake"
                                            Background="#FF31363D" Foreground="#FFD8DCE0" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Presence, Mode=OneWay}" FontSize="11"
                                               Foreground="#FF9BA3AD" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- body: replay of the last N pane_events rows. It scrolls — a pane
                                     holds more transcript than it has pixels, and the answer to that
                                     is a scrollbar, not an ellipsis. Follows the tail unless the
                                     operator has scrolled up (Transcript_ScrollChanged). -->
                                <ScrollViewer Grid.Row="1" Visibility="{Binding BodyVisibility}"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly" ScrollChanged="Transcript_ScrollChanged">
                                    <ItemsControl ItemsSource="{Binding Lines}" TextElement.FontSize="12"
                                                  ItemTemplate="{StaticResource TranscriptLine}"/>
                                </ScrollViewer>

                                <!-- an empty slot stays a slot -->
                                <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="— empty slot —" FontSize="12"
                                           Foreground="#FF4A4F57" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding EmptyVisibility}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <!-- boot-to-zero: no workspace awake at all. A REAL state, not an error
                     (§4) — the input box below is still the front door, because typing is
                     how you start and clicking is only for looking. -->
                <StackPanel x:Name="ZeroState" Grid.Row="0" Visibility="{Binding ZeroVisibility}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="nothing awake" FontSize="20" Foreground="#FF6B7079"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Say what you want done, and where — Dodona will wake it or make it."
                               FontSize="12" Foreground="#FF4A4F57" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ══ collapsed lanes: wrapped chips (§8 as revised) ══
                     Set aside, not stopped. Each keeps its lane colour and its attention badge,
                     so a collapsed lane can still say "you are needed here"; clicking expands
                     it. Wrapped rather than one row each, so twenty collapsed lanes cost two
                     lines instead of eating the grid they were collapsed to protect. -->
                <ItemsControl x:Name="CollapsedStrip" Grid.Row="1" ItemsSource="{Binding CollapsedLanes}"
                              Visibility="{Binding CollapsedVisibility}" Margin="5,4,5,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,5,4" Padding="7,3" CornerRadius="4" Background="#FF1F2227"
                                    BorderBrush="{Binding BorderBrushValue}" BorderThickness="{Binding BorderThicknessValue}"
                                    Cursor="Hand" MouseLeftButtonDown="Collapsed_Click"
                                    AutomationProperties.Name="collapsed-lane"
                                    ToolTip="Click to expand this lane">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="9" Height="9" RadiusX="2" RadiusY="2"
                                               Fill="{Binding LaneBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Left" FontWeight="Bold" FontSize="11"
                                               Foreground="#FFC6CCD4" VerticalAlignment="Center">
                                        <Run Text="{Binding FocusMark, Mode=OneWay}"/><Run Text="{Binding Title, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock DockPanel.Dock="Left" Text=" ⚠" FontSize="11" Foreground="White"
                                               Visibility="{Binding GlyphVisibility}" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Left" Background="#FFCB4B4B" CornerRadius="7" Padding="5,0"
                                            Margin="6,0,0,0" Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="10"
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Presence, Mode=OneWay}" FontSize="10"
                                               Foreground="#FF6B7079" VerticalAlignment="Center" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ bands: one row per other awake workspace (§6) ══
                     The tray idiom at workspace scale. Clicking one swaps which workspace
                     holds the grid — a VIEW choice only: no lane is demoted, evicted or
                     trayed by being in a band (LANE-LIFECYCLE §2 stands). -->
                <ScrollViewer Grid.Row="2" MaxHeight="132" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2"
                              Visibility="{Binding BandsVisibility}">
                <ItemsControl x:Name="BandStrip" ItemsSource="{Binding Bands}" Margin="5,2,5,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3,0,0" Padding="8,5" CornerRadius="6" Background="#FF1B1E23"
                                    BorderBrush="{Binding WorkspaceBrush}" BorderThickness="2,0,0,0"
                                    Cursor="Hand" MouseLeftButtonDown="Band_Click"
                                    AutomationProperties.Name="workspace-band"
                                    ToolTip="Click to give this workspace the grid">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="9" Height="9" RadiusX="2" RadiusY="2"
                                               Fill="{Binding WorkspaceBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                               Foreground="#FFC6CCD4" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Left" Background="#FFCB4B4B" CornerRadius="8" Padding="5,0"
                                            Margin="7,0,0,0" Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="10"
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="10"
                                               Foreground="#FF6B7079" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <!-- lane chips: awareness, not panes -->
                                    <ItemsControl ItemsSource="{Binding Lanes}" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,5,0" Padding="5,1" CornerRadius="3" Background="#FF262A30"
                                                        ToolTip="{Binding ToolTipText}">
                                                    <DockPanel>
                                                        <Rectangle DockPanel.Dock="Left" Width="6" Height="6" RadiusX="1" RadiusY="1"
                                                                   Fill="{Binding ChipBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="10"
                                                                   Foreground="#FF9BA3AD" VerticalAlignment="Center"/>
                                                        <Border DockPanel.Dock="Right" Background="#FFCB4B4B" CornerRadius="6"
                                                                Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding BadgeVisibility}">
                                                            <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="9"
                                                                       Foreground="White" FontWeight="Bold"/>
                                                        </Border>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ══ dispatcher column: fixed on the right, feed + tray + input (§8) ══ -->
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- which WORKSPACE holds the grid; click (or Ctrl+P) for the workspace
                     switcher — names only, never folders (a workspace is named, not located,
                     WORKSPACES-CONCIERGE.md §1). The feed below is a union across workspaces
                     (§6), so the header names the one the grid is showing rather than the one
                     the window was opened for. -->
                <DockPanel Grid.Row="0" Margin="4,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="DISPATCHER" FontWeight="Bold" FontSize="14" Foreground="#FF9AA3AE"/>
                    <Button DockPanel.Dock="Right" Click="Workspace_Click" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand"
                            ToolTip="Switch workspace (Ctrl+P)">
                        <TextBlock FontSize="11" Foreground="#FF6FA8DC">
                            <Run Text="{Binding WorkspaceLabel, Mode=OneWay}"/><Run Text=" ▾"/>
                        </TextBlock>
                    </Button>
                </DockPanel>

                <Border Grid.Row="1" Background="#FF1F2227" CornerRadius="6" BorderBrush="#FF3A3E44" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Feed}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="6,4" Background="#FF262A30" CornerRadius="4" Opacity="{Binding RowOpacity}"
                                            BorderBrush="{Binding ChipBrush}" BorderThickness="2,0,0,0">
                                        <DockPanel>
                                            <!-- round chip = Dodona itself, square = a lane (ChipRadius) -->
                                            <Rectangle DockPanel.Dock="Left" Width="8" Height="8"
                                                       RadiusX="{Binding ChipRadius}" RadiusY="{Binding ChipRadius}"
                                                       Fill="{Binding ChipBrush}" Margin="0,4,6,0" VerticalAlignment="Top"/>
                                            <Button DockPanel.Dock="Right" Content="ack" FontSize="10" Padding="6,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Top" Visibility="{Binding AckVisibility}"
                                                    Click="Feed_Ack" Background="#FF31363D" Foreground="#FFD8DCE0" BorderThickness="0"/>
                                            <!-- Two axes, deliberately different palettes: the
                                                 lane name in the LANE's colour, the workspace
                                                 chip in the WORKSPACE's. Reusing the six lane
                                                 hues for workspaces would say a workspace is a
                                                 seventh lane. Collapsed entirely when only one
                                                 workspace is on screen — the axis carries no
                                                 information there (§6). -->
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#FFC6CCD4">
                                                <Run Text="{Binding Workspace, Mode=OneWay}" FontSize="9"
                                                     Foreground="{Binding WorkspaceBrush}"/><Run
                                                     Text=" " /><Run FontWeight="Bold" Text="{Binding LaneTitle, Mode=OneWay}"
                                                     Foreground="{Binding ChipBrush}"/><Run Text="  "/><Run Text="{Binding Body, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <DockPanel Grid.Row="2" Margin="4,6,4,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding TrayText}" FontSize="11" Foreground="#FF8A9099"/>
                    <!-- the 5-hour window (§2.6): the CLI's own number, with its age when
                         stale — it only updates when a lane takes a turn -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding QuotaText}" FontSize="11"
                               Foreground="{Binding QuotaBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
                <!-- wraps: a status line that matters is usually the one too long to fit -->
                <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="11" Foreground="#FF6FA8DC" Margin="4,4,0,4"
                           TextWrapping="Wrap" MaxHeight="60"/>
                <!-- ══ the dispatcher box: multiline, because a prompt is often a paragraph ══
                     Enter sends, Shift+Enter is a newline, and the grip drags it taller. It
                     grows on its own up to InputAutoCap as lines arrive; the FEED gives up the
                     pixels (its row is the only star-sized one), so a tall box never pushes
                     anything off the bottom of the window. -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Thumb x:Name="InputGrip" Grid.Row="0" Cursor="SizeNS" DragCompleted="InputGrip_DragCompleted"
                           AutomationProperties.Name="resize-input"
                           ToolTip="Drag to resize — double-click to fit the text"
                           DragDelta="InputGrip_DragDelta" MouseDoubleClick="InputGrip_Reset">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <!-- Transparent, not null: a null Background is not hit-testable,
                                     so the whole strip would look draggable and not be. -->
                                <Border Background="Transparent" Padding="0,3">
                                    <Rectangle Height="2" Width="46" RadiusX="1" RadiusY="1"
                                               Fill="#FF3A3E44" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <!-- Dictation (docs/VOICE-INPUT-PLAN.md §5). Three states and the third is
                         the point: OFF is an outline, LISTENING is filled in the status blue,
                         ERROR is filled amber with the reason in words beside it. A toggle that
                         is on and deaf must never look like a toggle that is on.
                         A Path and not a glyph character: a font that lacks the codepoint would
                         render a box, and §0.2's non-ASCII trap has cost this project rounds. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="ListenStatus" FontSize="11" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="#FF6FA8DC"
                                   Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                   MaxWidth="320"/>
                        <Button x:Name="MicButton" Click="Mic_Click" Width="16" Height="18"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" AutomationProperties.Name="microphone"
                                ToolTip="Dictation — click to listen">
                            <Path x:Name="MicGlyph" Stretch="Uniform" Width="9" Height="13"
                                  Stroke="#FF5A6069" StrokeThickness="1.2" Fill="Transparent"
                                  Data="M5,0.6 C6.2,0.6 7.1,1.5 7.1,2.7 L7.1,6.6 C7.1,7.8 6.2,8.7 5,8.7
                                        C3.8,8.7 2.9,7.8 2.9,6.6 L2.9,2.7 C2.9,1.5 3.8,0.6 5,0.6 Z
                                        M0.9,6.2 C0.9,8.5 2.7,10.3 5,10.3 C7.3,10.3 9.1,8.5 9.1,6.2
                                        M5,10.3 L5,12.8"/>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="InputBox" FontSize="13" Padding="6,4" Background="#FF262A30"
                                 Foreground="#FFD8DCE0" BorderBrush="#FF3A3E44" CaretBrush="#FFD8DCE0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200"
                                 MinHeight="64"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"/>
                        <!-- Top, not Center: the placeholder belongs on the first line of a box
                             that may be ten lines tall. -->
                        <TextBlock x:Name="InputHint" IsHitTestVisible="False" Margin="8,5,0,0" FontSize="12"
                                   Foreground="#FF5A6069" VerticalAlignment="Top"
                                   Text="Say what you want done — Enter sends, Shift+Enter for a new line"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══ overlay-maximize: raw transcripts need somewhere to render; Esc restores;
             the grid never reflows underneath (§8) ══ -->
        <Border Visibility="{Binding OverlayVisible}" Background="#E6121417">
            <Border Margin="60" Background="#FF1F2227" CornerRadius="8"
                    BorderBrush="{Binding OverlayPane.LaneBrush, FallbackValue=Gray}" BorderThickness="2">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock FontWeight="Bold" FontSize="20" Text="{Binding OverlayPane.Title, FallbackValue=''}"/>
                        <TextBlock DockPanel.Dock="Right" Text="Esc to restore" FontSize="11" Foreground="#FF8A9099"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                                  ScrollChanged="Overlay_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding OverlayPane.Lines, FallbackValue={x:Null}}"
                                      TextElement.FontSize="13" ItemTemplate="{StaticResource TranscriptLine}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- ══ THE ASK (docs/LOCATIONS-PLAN.md Phase 4, decision D-L4) ══
             One component, two render modes: these pixels, and `ui dump`'s `ask` key. Both read
             the SAME open `questions` row and both answer through the SAME method
             (MainWindow.AnswerAsk → the daemon's `answer` command), so only pixels diverge.

             NOT A MODAL, and that is the decision rather than a style choice: a test window is
             forbidden from producing one (see MainWindow.IsTestWindow), which would make a modal
             ask permanently untestable — and `PickerWindow` and `StartLaneWindow` being dialogs
             is precisely why they have no coverage at all.

             NOT A FOLDER PICKER either (CLAUDE.md §3.1, operator directive). The choices are
             NAMES the system already knows — projects and workspaces — never a filesystem tree
             to navigate, never a Browse button, never a path in chrome. If this ever grows a
             folder list, it has become the thing that was deliberately deleted in 2026-08-18.

             Last in the Grid, so it renders ABOVE the transcript overlay: a question is a
             decision the operator has to make, and a maximised transcript is something they were
             reading. Escape puts it down without answering (MainVm.DismissAsk) — the row stays
             open and the feed still carries it, because an overlay that cannot be put down is a
             modal in all but name. -->
        <Border Visibility="{Binding AskVisible}" Background="#E6121417">
            <Border MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#FF1F2227" CornerRadius="8" BorderBrush="#FFC79A63" BorderThickness="2"
                    Padding="20" AutomationProperties.Name="ask-overlay">
                <StackPanel>
                    <!-- Dodona's own voice: the trunk colour and a round chip, the same way a
                         system feed row says "this is not a seventh lane" (Ink.System). -->
                    <DockPanel Margin="0,0,0,12">
                        <Ellipse Width="10" Height="10" Fill="#FFC79A63" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="Esc to put this down — it stays in the feed"
                                   FontSize="11" Foreground="#FF8A9099" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Ask.ScopeLabel}" Margin="8,0,0,0" FontSize="11"
                                   Foreground="#FF8A9099" VerticalAlignment="Center"
                                   Visibility="{Binding Ask.ScopeVisibility}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Ask.Question}" FontSize="17" TextWrapping="Wrap"
                               Foreground="#FFE6ECF4"/>
                    <ItemsControl ItemsSource="{Binding Ask.Choices}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A BUTTON, not a line of text telling the operator to go and
                                     type a command. "undo: dodona lane-stop 3" printed at a GUI
                                     user was this project's original sin, and P4.5 is the same
                                     mistake one layer down: a refusal that instructed. -->
                                <Button Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Left"
                                        Background="#FF2A3037" Foreground="#FFE6ECF4" BorderBrush="#FF3A424C"
                                        BorderThickness="1" Cursor="Hand"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Click="AskChoice_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Why}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="#FF8A9099" TextWrapping="Wrap"
                                                   Visibility="{Binding WhyVisibility}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- A candidates blob that will not parse still renders the question, and says
                         how to answer it. Silence would be the silent degrade CLAUDE.md §3 calls
                         a bug. -->
                    <TextBlock Visibility="{Binding Ask.NoChoicesVisibility}" FontSize="11"
                               Foreground="#FFE0A94E" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="This question offered no readable choices — answer it in words with `dodona answer`."/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
