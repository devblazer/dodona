<Window x:Class="DodonaUi.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodona" Width="560" Height="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#FF17191D" FontFamily="Segoe UI" Foreground="#FFD8DCE0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Workspaces" FontSize="30" FontWeight="Light"/>
        <!-- Workspaces, never folders: a workspace is a named session group and locations
             are the router's business (WORKSPACES-CONCIERGE.md §1). The folder picker this
             window used to be is gone (2026-08-18) and must not come back. -->
        <TextBlock Grid.Row="1" Margin="0,2,0,18" FontSize="12" Foreground="#FF8A9099"
                   Text="Named session groups, each with its own lanes, memory and merge queues. Pick one to wake it and give it the grid."
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="#FF1F2227" CornerRadius="6" BorderBrush="#FF3A3E44" BorderThickness="1">
            <Grid>
                <ListBox x:Name="WsList" Background="Transparent" BorderThickness="0" Foreground="#FFD8DCE0"
                         MouseDoubleClick="WsList_DoubleClick" SelectionChanged="WsList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{Binding StatusBrush}" CornerRadius="8"
                                        Padding="7,1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FF17191D" FontWeight="Bold"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FF8A9099"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint"
                           Text="No workspaces yet — type in the shell. Describing work is how one gets created and woken."
                           FontSize="12" Foreground="#FF4A4F57" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock x:Name="Warning" Grid.Row="3" Margin="2,10,0,0" FontSize="11" Foreground="#FFE0A96D"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <!-- No Browse, no Create, no Remove: workspaces are made and grown by typing
                 (the concierge ladder, WORKSPACES-CONCIERGE.md §5) — this window only
                 switches between the ones that exist. -->
            <TextBlock DockPanel.Dock="Left" FontSize="11" Foreground="#FF4A4F57" VerticalAlignment="Center"
                       Text="New workspaces are created by typing — just describe the work."/>
            <Button DockPanel.Dock="Right" x:Name="OpenBtn" Content="Open" Click="Open_Click" Padding="26,7"
                    Background="#FF4FC3F7" Foreground="#FF10131A" BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                    IsEnabled="False"/>
        </DockPanel>
    </Grid>
</Window>
