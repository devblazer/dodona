<Window x:Class="DodonaUi.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodona" Width="760" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#FF17191D" FontFamily="Segoe UI" Foreground="#FFD8DCE0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dodona" FontSize="30" FontWeight="Light"/>
        <TextBlock Grid.Row="1" Margin="0,2,0,18" FontSize="12" Foreground="#FF8A9099"
                   Text="Open a project. Each project runs its own lanes, worktrees and merge queue — nothing is shared between them."
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="#FF1F2227" CornerRadius="6" BorderBrush="#FF3A3E44" BorderThickness="1">
            <Grid>
                <ListBox x:Name="Recents" Background="Transparent" BorderThickness="0" Foreground="#FFD8DCE0"
                         MouseDoubleClick="Recents_DoubleClick" SelectionChanged="Recents_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{Binding StatusBrush}" CornerRadius="8"
                                        Padding="7,1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FF17191D" FontWeight="Bold"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding NameBrush}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FF8A9099"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="No projects yet — Browse… for a git repository to work in."
                           FontSize="12" Foreground="#FF4A4F57" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock x:Name="Warning" Grid.Row="3" Margin="2,10,0,0" FontSize="11" Foreground="#FFE0A96D"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Browse…" Click="Browse_Click" Padding="16,7"
                    Background="#FF31363D" Foreground="#FFD8DCE0" BorderThickness="0" FontSize="13"/>
            <Button DockPanel.Dock="Left" x:Name="ForgetBtn" Content="Remove from list" Click="Forget_Click" Margin="8,0,0,0"
                    Padding="12,7" Background="Transparent" Foreground="#FF8A9099" BorderThickness="0" FontSize="12"
                    IsEnabled="False"/>
            <Button DockPanel.Dock="Right" x:Name="OpenBtn" Content="Open" Click="Open_Click" Padding="26,7"
                    Background="#FF4FC3F7" Foreground="#FF10131A" BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                    IsEnabled="False"/>
        </DockPanel>
    </Grid>
</Window>
