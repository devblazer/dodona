<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI is disposable by design (§13): a dumb view over the store. It holds no
       state an agent cares about — reads via a read-only WAL connection, writes only
       through the daemon's control pipe, and can be killed and rebuilt mid-session. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DodonaUi</AssemblyName>
    <RootNamespace>DodonaUi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>
