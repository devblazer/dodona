<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI is disposable by design (§13): a dumb view over the store. It holds no
       state an agent cares about — reads via a read-only WAL connection, writes only
       through the daemon's control pipe, and can be killed and rebuilt mid-session. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DodonaUi</AssemblyName>
    <RootNamespace>DodonaUi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the oracle's oak (assets/dodona.ico, generated by tools/IconGen) — the window,
         taskbar and desktop shortcut all inherit it from the exe -->
    <ApplicationIcon>..\..\assets\dodona.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Capture only, for dictation (docs/VOICE-ENGINE-PLAN.md E2). NAudio gives WasapiCapture
         and MediaFoundationResampler; the RECOGNITION is a WebSocket in DeepgramRecognizer.cs,
         so nothing here does any speech work. The resample to 16 kHz is the part that matters:
         almost every real device captures at 44.1 or 48 kHz, and sending 48 kHz audio to an
         endpoint told sample_rate=16000 produces fast, confident nonsense indistinguishable
         from the SAPI gibberish this replaced. THE RESAMPLE IS THE LIBRARY'S AND NOT OURS
         (D-E9): a hand-rolled windowed-sinc version was written and reverted, because the
         extension this engine mimics never resamples in its own code either, and unproven DSP
         in that position fails as confident nonsense rather than as a red check. Pcm16 keeps
         only the MEASUREMENT half, which is how the rate is pinned without an ear.
         System.Speech is GONE with SapiRecognizer.cs (D-E6): a fallback that emits gibberish is
         worse than an error saying "no network", because gibberish looks like the feature
         working badly rather than not working. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared SOURCE, not an assembly reference: instance identity must be derived
         identically by the daemon, the CLI and the UI (§14 — two spellings of one root
         would mean two merge tokens), while the UI stays runtime-decoupled and
         disposable (§13). -->
    <Compile Include="..\Dodona\Instance.cs" Link="Instance.cs" />
    <!-- Workspace identity, for the same reason and with the same force: the UI has to
         resolve "which workspace owns this folder" to the SAME answer the daemon does, or
         it would read one store and write to another's pipe. Paths.cs comes with it
         because a store's location is now derived from a workspace id, not from a root. -->
    <Compile Include="..\Dodona\Paths.cs" Link="Paths.cs" />
    <Compile Include="..\Dodona\Workspaces.cs" Link="Workspaces.cs" />
    <Compile Include="..\Dodona\WorkspaceResolve.cs" Link="WorkspaceResolve.cs" />
    <Compile Include="..\Dodona\Repos.cs" Link="Repos.cs" />
    <!-- Claims.cs comes with Repos.cs, because Repos VALIDATES claims (CheckClaims,
         ForClaims) and derives a repository's claim prefix from Claims.Prefix — one
         definition of that rule, since two copies drifting apart is how an open ticket's
         claim namespace moves underneath it (Phase 0's incident). The file is pure string
         comparison with no dependencies at all, so linking it costs nothing. -->
    <Compile Include="..\Dodona\Claims.cs" Link="Claims.cs" />
    <!-- Which PROJECT a lane is in, and what to say about it. Linked for the same reason as
         Instance and Workspaces above: the window must reach the SAME answer the daemon
         reaches, and two implementations of "which project is this lane in" would be two
         answers to the question docs/LOCATIONS-PLAN.md Phase 1 exists to make answerable. -->
    <Compile Include="..\Dodona\Projects.cs" Link="Projects.cs" />
    <!-- The asking component's pure half (docs/LOCATIONS-PLAN.md Phase 4, D-L4). Linked for
         the strongest form of the same reason: the daemon WRITES a question's candidates and
         the window PARSES them, and the whole of D-L4 is that there is one component over one
         row. Two parsers of `questions.candidates` would be the two-systems divergence Phase 4
         exists to prevent, and only one of them would ever be tested. -->
    <Compile Include="..\Dodona\Ask.cs" Link="Ask.cs" />
    <!-- Mid-turn progress, for the strongest form of that same reason: the daemon WRITES
         `progress` rows and the pane FOLDS them, and a fold that disagreed with the writer
         about what a row means would be the two-implementations divergence one file over.
         Pure functions over a tool name and a list of rows — no store, no window. -->
    <Compile Include="..\Dodona\PaneProgress.cs" Link="PaneProgress.cs" />
    <!-- Dictation's pure half (docs/VOICE-INPUT-PLAN.md Phase A). Linked for the same reason
         Ask.cs and PaneProgress.cs are: the half worth testing must not need a device, so the
         state machine, the splice, the punctuation table and the submit-race guard live in a
         file with no WPF and no microphone in it, on the 1-second `dev test unit` loop rather
         than behind a window. It is also where the operator's constraint is ENFORCED rather
         than remembered: DictationAct has no member meaning "send", so the decision layer
         cannot ask for a submit even if a caller wanted one (D-V1). -->
    <Compile Include="..\Dodona\Dictation.cs" Link="Dictation.cs" />
    <!-- The cloud engine's PURE half (docs/VOICE-ENGINE-PLAN.md E3), linked for the same reason
         and with the same force. The protocol is where the surprises were: measured on
         2026-08-20 the plan was wrong about where the error text lives AND about the upgrade
         status being the auth answer. A protocol living behind a socket is a protocol no check
         can reach, so the frame parser, the interim-holding turn, the fatal/transient
         classification and the keyterm cap are all in a file with no socket in it. -->
    <Compile Include="..\Dodona\SpeechStream.cs" Link="SpeechStream.cs" />
    <!-- And the audio arithmetic, for the loudest trap in the plan: a wrong resample is not a
         crash and not a red check, it is confident nonsense that looks like a bad speech engine.
         The resample itself is MediaFoundation's (D-E9, hand-rolled DSP here was reverted); what
         is pure is the MEASUREMENT, so a check can push a 440 Hz tone through the real capture
         path and demand 440 Hz comes out, catching the chipmunk failure with no ear. -->
    <Compile Include="..\Dodona\Pcm16.cs" Link="Pcm16.cs" />
    <!-- Ver too, and for the same reason: the UI is its own build with its own hot swap
         (§13), so it has to be able to say which build it is. Ver.Build reads
         typeof(Ver).Assembly, so compiled in here it reports the UI's identity, not the
         daemon's — which is the whole point when the two can differ. -->
    <Compile Include="..\Dodona\Ver.cs" Link="Ver.cs" />
  </ItemGroup>

  <!-- The window's pure-logic tests (tests\Dodona.Ui.Tests, net8.0-windows) reach
       FakeRecognizer, Poses and the rest. Those are `class` with no modifier, i.e. internal, and
       they stay that way for the same reason Dodona.csproj gives: what counts as this
       assembly's API is a design decision, and it does not get widened because a test wants in.
       This grants the one assembly access instead.

       The grant is what makes W3.0's project possible at all, and the two types it is really
       for are the two DOUBLES that live in this assembly and nowhere else. The double ledger's
       reflection rung has to be able to SEE them, and a rung that enumerates a population
       containing neither is a rung that is green because the set is empty
       (docs/TEST-ARCHITECTURE-PLAN.md 3.2). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Dodona.Ui.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
