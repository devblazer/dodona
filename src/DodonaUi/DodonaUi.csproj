<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI is disposable by design (§13): a dumb view over the store. It holds no
       state an agent cares about — reads via a read-only WAL connection, writes only
       through the daemon's control pipe, and can be killed and rebuilt mid-session. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DodonaUi</AssemblyName>
    <RootNamespace>DodonaUi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the oracle's oak (assets/dodona.ico, generated by tools/IconGen) — the window,
         taskbar and desktop shortcut all inherit it from the exe -->
    <ApplicationIcon>..\..\assets\dodona.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared SOURCE, not an assembly reference: instance identity must be derived
         identically by the daemon, the CLI and the UI (§14 — two spellings of one root
         would mean two merge tokens), while the UI stays runtime-decoupled and
         disposable (§13). -->
    <Compile Include="..\Dodona\Instance.cs" Link="Instance.cs" />
  </ItemGroup>

</Project>
