<Project Sdk="Microsoft.NET.Sdk">

  <!-- The daemon and its console client: one binary, two roles, always separate
       processes. The daemon role owns the store and the lanes; every other subcommand
       is a client over the control pipe. The M4 hot-swap split falls out of this shape. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>dodona</AssemblyName>
    <RootNamespace>Dodona</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\..\assets\dodona.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!-- The pure-logic tests (tests\Dodona.Tests) reach Claims, Policy, Repos, Instance and the
       code-only routing decisions. Those are  with no modifier — internal — and
       they stay that way: what counts as this assembly's API is a design decision, and it does
       not get widened because a test wants in. This grants the one assembly access instead. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Dodona.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
