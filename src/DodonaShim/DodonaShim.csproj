<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shim is the one piece that must "essentially never change" (design §13).
       Dependency-free on purpose; published self-contained/AOT for real use so it
       never shares the daemon's build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
