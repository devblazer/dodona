<Project Sdk="Microsoft.NET.Sdk">

  <!-- The fake agent (design §17): anything that speaks claude's stream-json shape is
       an agent as far as the shim and daemon know. Deterministic, instant, free —
       all orchestration logic is tested against this, never against live models. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
