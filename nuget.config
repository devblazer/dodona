<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repo-scoped feed: this machine has no global NuGet sources configured.
       Kept in-repo so builds are reproducible anywhere. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
